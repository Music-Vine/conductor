# Session secret for JWT signing (generate with: openssl rand -base64 32)
SESSION_SECRET=your-secret-key-here-minimum-32-characters

# API base URLs (optional, defaults to /api/mv and /api/ub)
NEXT_PUBLIC_MV_API_BASE=/api/mv
NEXT_PUBLIC_UB_API_BASE=/api/ub

# Backend API Integration (Phase 8)
# Set NEXT_PUBLIC_USE_REAL_API=true to switch from mock data to real backend
NEXT_PUBLIC_USE_REAL_API=false
BACKEND_API_BASE_URL=https://api.internal.example.com
BACKEND_API_SECRET=your-backend-api-secret-here

# Cognito / Google Workspace Authentication
# NEXT_PUBLIC_COGNITO_CLIENT_ID — from Terraform output: musicvine_admin_client_id
NEXT_PUBLIC_COGNITO_CLIENT_ID=
# COGNITO_DOMAIN — full Cognito domain URL (no trailing slash)
# e.g. https://hades-uppbeat-api-access.auth.eu-west-2.amazoncognito.com
COGNITO_DOMAIN=
# COGNITO_REDIRECT_URI — must match the callback URL registered in the Cognito app client
# e.g. https://musicvine-admin.ub-hades-yzv5hh8yisi6lnjobthx.cc/auth/callback
# For local dev: http://localhost:3000/auth/callback  (add this to the Cognito client callback_urls)
COGNITO_REDIRECT_URI=http://localhost:3000/auth/callback
# COGNITO_API_SCOPE — resource server scope; must match AWSCognito:Scope in the API appsettings
# e.g. hades-api/access  (production: production-api/access)
COGNITO_API_SCOPE=hades-api/access
